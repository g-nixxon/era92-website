# Copy this file to .env.local for local development.
# In Vercel, set these in Project → Settings → Environment Variables
# (for Production, Preview, and Development environments as appropriate).

# Where the /hire form POSTs lead submissions. Set this to your
# Mailchimp / ConvertKit / Formspree / n8n / custom webhook URL.
# Form logic does not change when you swap providers — only this URL.
LEAD_WEBHOOK_URL=https://example.com/webhook-placeholder

# Address shown in the /hire form's fallback email link and used as
# the "from / reply-to" intent for any provider that needs it.
LEAD_NOTIFICATION_EMAIL=trinity@era92.com
